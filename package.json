{
  "name": "finanzblick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "tsx --env-file-if-exists=.env.local scripts/statement-worker.ts",
    "backfill": "tsx --env-file-if-exists=.env.local scripts/statement-backfill.ts",
    "merchants:import": "tsx --env-file-if-exists=.env.local scripts/merchant-import.ts",
    "merchants:authorized-logos": "tsx scripts/merchant-authorized-logos.ts",
    "benchmark:recognition": "tsx --env-file-if-exists=.env.local scripts/statement-recognition-benchmark.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.mjs README.md"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "exceljs": "^4.4.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
